# NirmiqEcho configuration
# Copy this to .env and fill in values

# ── Local-LLM fallback (optional, 100% offline) ───────────────────────
# When a spoken request doesn't match a built-in command, Echo asks a LOCAL
# Ollama model to rewrite it as a known command ("fire up my browser" ->
# "open chrome"). No cloud, no API key. If Ollama isn't running this is an
# instant no-op and Echo stays fully offline.
#   LLM_FALLBACK=0   to disable entirely
#   OLLAMA_MODEL     model to use (default qwen3.5:4b)
#   OLLAMA_URL       endpoint   (default http://localhost:11434)
LLM_FALLBACK=1
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434

# ── Whisper model ─────────────────────────────────────────────────────
# LEAVE BLANK for auto-detect (recommended):
#   GPU found  → large-v3 float16  (99.5% acc, 1-2s commands)
#   CPU only   → small.en          (97% acc, 1-2s commands, 500MB)
# Set explicitly only to force a specific model on any device:
#   small.en | medium.en | large-v3
WHISPER_MODEL=

# ── Input microphone ─────────────────────────────────────────────────
# LEAVE BLANK for auto-detect: uses the Windows default mic, but if it is
# silent (e.g. idle Bluetooth buds), Echo scans and picks a live mic.
# Set to a device index or name fragment to pin one, e.g.:
#   INPUT_DEVICE=Microphone Array     (laptop's built-in mic)
# Run "python mic_check.py" inside voiceflow_local to list devices.
INPUT_DEVICE=

# ── VAD sensitivity ───────────────────────────────────────────────────
# Lower = catches quieter voices. Raise if lots of false triggers.
# Default: 400 (suits a quiet room)
SPEECH_RMS_THRESHOLD=400

# ── Noise reduction strength ──────────────────────────────────────────
# 0.0 = off, 1.0 = maximum.
# 0.65 is conservative — removes room noise without touching the voice.
# Raise to 0.80+ only if in a very noisy environment; lower reduces latency.
NOISE_REDUCE_STRENGTH=0.65

# ── Model quantization / footprint ────────────────────────────────────
# Compute type = the accuracy vs. size/RAM trade-off. LEAVE BLANK for auto:
#   GPU → float16   ·   CPU → int8 (~half the RAM)
# Force a lighter/faster path on any device:  int8 | int8_float16 | float16
WHISPER_COMPUTE=

# ── Behavior ──────────────────────────────────────────────────────────
# Auto-start listening as soon as the model is ready (no F9 needed).
# Set 0 to require pressing F9 first.
AUTORUN=1

# ── Spotify playback tuning (optional) ────────────────────────────────
# After searching, Echo tabs to the first result and presses play. Tune the
# reach if your Spotify layout differs; set SPOTIFY_AUTOPLAY=0 to only cue the
# search (never auto-press play).
SPOTIFY_AUTOPLAY=1
SPOTIFY_PLAY_TABS=4
